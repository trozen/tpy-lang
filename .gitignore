# Python-generated files
__pycache__/
tpyc/_buildinfo.py

# TurboPython build output
__tpyc__/
*.py[oc]
# Anchored: these are repo-root packaging outputs (setuptools/hatchling).
# Without the leading slash, `build/` would match `tpyc/build/` (the
# third-party-lib registry package) and silently drop it from commits;
# same trap latent for any future nested `dist/` / `wheels/`.
/build/
/dist/
/wheels/
*.egg-info

# Virtual environments
.venv

/tmp
*.gch
.gitr/
.ccsbx/

# pytest-hosts per-checkout override (personal experiments)
.pytest-hosts.toml
scripts/alias_kill_matrix/build/

# Local banned-word list for scripts/git-hooks/commit-msg (private)
/.commit-banned-words

# Per-worktree session queue of the orchestrating session (SESSION_RULES.md)
/SESSION.md
