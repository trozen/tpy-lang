{
  "configs": [
    {
      "name": "2404-gcc13",
      "base_image": "ubuntu:24.04",
      "toolchain_pkgs": "g++-13",
      "cxx": "gcc-13"
    },
    {
      "name": "2404-gcc14",
      "base_image": "ubuntu:24.04",
      "toolchain_pkgs": "g++-14",
      "cxx": "gcc-14"
    },
    {
      "name": "2404-clang19",
      "base_image": "ubuntu:24.04",
      "toolchain_pkgs": "clang-19",
      "cxx": "clang-19"
    },
    {
      "name": "2404-clang20",
      "base_image": "ubuntu:24.04",
      "toolchain_pkgs": "clang-20",
      "cxx": "clang-20"
    },
    {
      "name": "2604-gcc15",
      "base_image": "ubuntu:26.04",
      "toolchain_pkgs": "g++-15",
      "cxx": "gcc-15"
    },
    {
      "name": "2604-clang21",
      "base_image": "ubuntu:26.04",
      "toolchain_pkgs": "clang-21",
      "cxx": "clang-21"
    },
    {
      "name": "zig",
      "base_image": "ubuntu:24.04",
      "toolchain_pkgs": "",
      "uv_extras": ["bundled"],
      "cxx": "zig-bundled"
    },
    {
      "name": "macos-arm64",
      "base_image": "ubuntu:24.04",
      "toolchain_pkgs": "clang-19",
      "cxx": "/opt/osxcross/bin/arm64-apple-darwin25.5-clang++-19",
      "mounts": ["~/tpy-nightly/osxcross/target:/opt/osxcross:ro"],
      "env": ["LD_LIBRARY_PATH=/opt/osxcross/lib"],
      "requires": [
        "~/tpy-nightly/osxcross/target/bin/arm64-apple-darwin25.5-clang++-19",
        "~/tpy-nightly/osxcross/target/bin/arm64-apple-darwin25.5-clang-19"
      ]
    },
    {
      "name": "2404-gcc14-sysdeps",
      "base_image": "ubuntu:24.04",
      "toolchain_pkgs": "g++-14",
      "extra_pkgs": "libpcre2-dev libmbedtls-dev",
      "cxx": "gcc-14",
      "pytest_args": ["--dep-mode", "pcre2=system,mbedtls=system"]
    },
    {
      "name": "cpy-3.12",
      "base_image": "ubuntu:24.04",
      "cpython": "3.12"
    },
    {
      "name": "cpy-3.13",
      "base_image": "ubuntu:24.04",
      "cpython": "3.13"
    },
    {
      "name": "cpy-3.14",
      "base_image": "ubuntu:24.04",
      "cpython": "3.14"
    },
    {
      "name": "thir-stdlib",
      "base_image": "ubuntu:24.04",
      "no_exec": true,
      "pytest_args": ["--thir-stdlib"]
    },
    {
      "name": "thir-stdlib-fallback",
      "base_image": "ubuntu:24.04",
      "script": "uv run python scripts/thir_migration/thir_stdlib_fallback.py --max-fallback 0"
    },
    {
      "name": "macos-native",
      "ssh": { "host": "tpy-nightly-mac", "workdir": "tpy-nightly-work" },
      "timeout": 21600
    }
  ]
}
